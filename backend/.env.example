# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas (free M0 cluster never sleeps - unlike some other free tiers)
# Get this from Atlas > Connect > Drivers. Replace <password> and add /gymdb before the "?"
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gymdb?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# First platform superadmin (used only by seed:superadmin script, run once)
SUPERADMIN_EMAIL=superadmin@gymsaas.com
SUPERADMIN_PASSWORD=ChangeMe123!

# CORS - your frontend URL
CLIENT_URL=http://localhost:5173
